# Options: development, staging, production
APP_ENV=development

# App Server Port
PORT=8000

# Database Configuration
#
# For Supabase (staging/production):
# Use the connection pooler for application connections (recommended)
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql+asyncpg://postgres.foobar:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres
#
# For local development with Docker PostgreSQL:
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jaacountable_db

# PostgreSQL Docker Configuration (used by docker-compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=jaacountable_db
POSTGRES_PORT=5432

# Database Connection Pool
DB_POOL_MIN_SIZE=1          # Minimum connections in pool (keep low for free-tier DBs)
DB_POOL_MAX_SIZE=5          # Maximum connections in pool (Supabase free tier: ~60 total)
DB_POOL_CONNECT_TIMEOUT=10  # Seconds to wait for each individual connection attempt
DB_POOL_MAX_RETRIES=5       # Max attempts to create the pool before giving up (handles cold starts)
DB_POOL_RETRY_BASE_BACKOFF=2.0  # Base for exponential backoff between retries (2^attempt seconds)

# Anthropic API Key (for LiteLLM classification models — anthropic/claude-haiku-4-5)
ANTHROPIC_CLASSIFICATION_API_KEY=sk-ant-abc123

# Deprecated: kept for legacy scripts (scripts/infrastructure/generate_seed.py, poc_newspaper_archive.py)
# that still grep for this name. New code uses ANTHROPIC_CLASSIFICATION_API_KEY.
OPENAI_CLASSIFICATION_API_KEY=sk-abc123

# Logging Configuration
LOG_LEVEL=INFO  # Options: TRACE, DEBUG, INFO, SUCCESS, WARNING, ERROR, CRITICAL
LOG_JSON=false  # Enable JSON structured logging (true/false)
LOG_FILE=false  # Enable file logging (true/false)

# Sentry Error Tracking
SENTRY_DSN=                                # Get from Sentry project Settings → Client Keys

# PostHog Analytics
# Get your project API key from your PostHog project settings
POSTHOG_API_KEY=                           # Leave empty to disable analytics
POSTHOG_HOST=https://app.posthog.com       # Override for self-hosted PostHog

# Cache Settings
CACHE_TTL_SECONDS=300 # in seconds

# Redis Cache (optional — leave empty to use in-memory cache)
# Local Docker:  redis://localhost:6379
# Render (internal): redis://red-xxxx:6379
# Render (external): rediss://:password@red-xxxx.render.com:6380
CACHE_URL=

# S3 / Supabase Storage
# Production: get credentials from Supabase Dashboard → Project Settings → Storage → S3 Connection
# Local dev:  use LocalStack defaults below
S3_ENDPOINT_URL=http://localhost:4566
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_REGION=us-east-1
S3_BUCKET=article-discovery

# LocalStack (local S3 emulator)
# Sign up at https://app.localstack.cloud to get your auth token (free Hobby tier covers S3)
LOCALSTACK_AUTH_TOKEN=           # Required to start the localstack service in docker-compose.yml
LOCALSTACK_DOCKER_NAME=localstack-main
LOCALSTACK_VOLUME_DIR=./volume

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values as needed for your environment
# 3. Never commit .env to version control (it's in .gitignore)
